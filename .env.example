# Generate with: openssl rand -hex 24
# Use hexadecimal characters here so the database URL needs no escaping.
POSTGRES_PASSWORD=replace_with_random_hex_password
# Local Docker: :80; public deployment: questions.example.com (no scheme)
SITE_ADDRESS=:80
APP_ORIGIN=http://localhost
# Change to 0.0.0.0 only when deploying publicly with demo auth disabled.
PUBLIC_BIND=127.0.0.1
GOOGLE_CLIENT_ID=
ALLOW_DEMO_AUTH=false
DEMO_PAYMENTS_ENABLED=true
# Optional: http://ollama:11434, then run the ai profile and pull the model.
OLLAMA_URL=
OLLAMA_MODEL=qwen2.5:3b
