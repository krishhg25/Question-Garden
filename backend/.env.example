DATABASE_URL=sqlite:///./question_generator.db
GOOGLE_CLIENT_ID=
# Enable only on your local machine. Every demo sign-in uses one shared demo user.
ALLOW_DEMO_AUTH=true
DEMO_PAYMENTS_ENABLED=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CREDIT_TIMEZONE=Asia/Kolkata
# Optional: leave blank for the offline extractive NLP engine.
OLLAMA_URL=
OLLAMA_MODEL=qwen2.5:3b
# Windows example: C:/Program Files/Tesseract-OCR/tesseract.exe
TESSERACT_CMD=
